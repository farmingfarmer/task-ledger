# Line-ending discipline: Windows batch/PowerShell need CRLF, POSIX
# shell needs LF, everything else normalizes. Prevents git-on-Windows
# autocrlf from corrupting scripts in either direction.
* text=auto
*.py text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.html text eol=lf
tl text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.png binary
