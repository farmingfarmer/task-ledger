@echo off
rem Register the cadence as a Windows scheduled task, so the ledger runs
rem itself: Postgres started if down, then one tick, every hour.
rem
rem Run this ONCE, from the repo root, in a window where the usual
rem variables are set (PGBIN, DB_DSN, TL_USER, TL_EXTRACT_MODEL,
rem TL_JUDGE_MODEL) -- it freezes those values into a generated
rem run_tick.bat, because a scheduled task inherits nobody's terminal.
rem The tick itself refuses cleanly if the database or a model is
rem missing, so a broken hour is one readable line in the log, never a
rem hung task.
rem
rem   deploy\windows\install_scheduled_tick.bat            install
rem   schtasks /Delete /TN TaskLedgerTick /F               remove
rem   type %USERPROFILE%\task-ledger-tick.log              what happened
rem
rem Written on another platform and untested here by its author; every
rem command in it is standard schtasks/cmd. If it misbehaves, the
rem generated %USERPROFILE%\task-ledger-run-tick.bat is plain text --
rem read it, run it by hand, and the fault will name itself.

setlocal
set "RUNNER=%USERPROFILE%\task-ledger-run-tick.bat"
set "REPO=%CD%"

if not exist "%REPO%\cadence\cadence_tick.py" (
  echo run this from the task-ledger repo root 1>&2
  exit /b 2
)
if "%TL_USER%"=="" (
  echo TL_USER is not set in this window -- set the usual variables first, 1>&2
  echo they are frozen into the generated runner. 1>&2
  exit /b 2
)

> "%RUNNER%" echo @echo off
>> "%RUNNER%" echo rem generated by install_scheduled_tick.bat -- edit freely
>> "%RUNNER%" echo set "PGBIN=%PGBIN%"
>> "%RUNNER%" echo set "DB_DSN=%DB_DSN%"
>> "%RUNNER%" echo set "TL_USER=%TL_USER%"
>> "%RUNNER%" echo set "TL_EXTRACT_MODEL=%TL_EXTRACT_MODEL%"
>> "%RUNNER%" echo set "TL_JUDGE_MODEL=%TL_JUDGE_MODEL%"
>> "%RUNNER%" echo cd /d "%REPO%"
>> "%RUNNER%" echo call deploy\windows\pg_start.bat
>> "%RUNNER%" echo python cadence\cadence_tick.py ^>^> "%USERPROFILE%\task-ledger-tick.log" 2^>^&1

schtasks /Create /F /SC HOURLY /TN TaskLedgerTick /TR "\"%RUNNER%\""
if errorlevel 1 (
  echo schtasks refused -- run it by hand or from an elevated prompt. 1>&2
  exit /b 1
)
echo.
echo installed: hourly tick as scheduled task "TaskLedgerTick"
echo   runner : %RUNNER%
echo   log    : %USERPROFILE%\task-ledger-tick.log
echo   remove : schtasks /Delete /TN TaskLedgerTick /F
endlocal
